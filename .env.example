# Nayara One — API
# Copie este arquivo para .env e preencha os valores reais localmente.
# Nunca commitar o arquivo .env preenchido.

# --- Aplicação ---
NODE_ENV=development
PORT=3000
APP_API_PREFIX=/api

# --- CORS ---
# Lista de origens do frontend autorizadas a chamar a API, separadas por vírgula
# (ex: https://homologacao-nayaraone--front.exemplo.com,https://app.nayaraimoveis.com.br).
# Sem valor definido, libera geral — aceitável só em homologação.
CORS_ORIGIN=

# --- Banco de dados (PostgreSQL) ---
# Opção A: uma única connection string (tem prioridade sobre as variáveis abaixo se definida)
DATABASE_URL=

# Opção B: variáveis segmentadas (usadas quando DATABASE_URL não está definida)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- Pool de conexões (opcional — possuem defaults seguros em src/config/database.js) ---
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# --- Smoke test (opcional) ---
SMOKE_TEST_HOST=localhost

# --- Autenticação (JWT) ---
# Segredos fortes e distintos entre access/refresh; nunca reutilizar entre ambientes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- PII (dados pessoais sensíveis) ---
# Segredo do HMAC usado para permitir busca exata de CPF/CNPJ sem armazenar o valor em claro
# (tax_id_normalized_hash). Obrigatório, sem fallback — gere um valor aleatório forte e distinto
# dos segredos de JWT; nunca reutilizar entre ambientes.
PII_HASH_SECRET=

# --- MFA (TOTP, RFC 6238) ---
# Chave de criptografia (AES-256-GCM) do segredo TOTP em repouso (src/utils/mfaCrypto.js).
# Obrigatória, sem fallback — 32 bytes: hex de 64 caracteres ou base64 equivalente. Gere um
# valor aleatório forte e distinto dos demais segredos; nunca reutilizar entre ambientes.
MFA_ENCRYPTION_KEY=
# Duração (minutos) da janela de "MFA recente" usada por requireRecentMfa/assertRecentMfa
# para liberar ações de step-up (aprovação de pagamento, liquidação, alteração bancária).
# DECISÃO DE ENGENHARIA — valor não especificado no Caderno técnico, a confirmar com o cliente.
MFA_STEP_UP_TTL_MINUTES=10
