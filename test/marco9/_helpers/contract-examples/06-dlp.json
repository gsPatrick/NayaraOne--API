{
  "area": "dlp",
  "examples": [
    {"op": "GET /dlp", "kind": "positive", "name": "visão geral do DLP", "as": "gestor", "expect": 200},
    {"op": "GET /dlp", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /dlp", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "GET /dlp/policies", "kind": "positive", "name": "políticas por classe e ação", "as": "gestor", "expect": 200},
    {"op": "GET /dlp/policies", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /dlp/policies", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "PUT /dlp/policies/{classification}/{action}", "kind": "positive", "name": "fixa a validade máxima da exportação MEDIUM", "as": "gestor", "expect": 200, "params": {"classification": "MEDIUM", "action": "EXPORT"}, "body": {"maxExpiryHours": 24}},
    {"op": "PUT /dlp/policies/{classification}/{action}", "kind": "negative", "name": "classe inexistente", "as": "gestor", "expect": 400, "params": {"classification": "SECRET", "action": "EXPORT"}, "body": {"allowed": true}},
    {"op": "PUT /dlp/policies/{classification}/{action}", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "params": {"classification": "MEDIUM", "action": "EXPORT"}},
    {"op": "GET /dlp/anomalies", "kind": "positive", "name": "anomalias de acesso em massa abertas", "as": "gestor", "expect": 200, "seed": "dlpAnomaly", "query": {"status": "OPEN"}},
    {"op": "GET /dlp/anomalies", "kind": "negative", "name": "filtro de situação inválido", "as": "gestor", "expect": 400, "query": {"status": "TALVEZ"}},
    {"op": "GET /dlp/anomalies", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "POST /dlp/anomalies/{id}/review", "kind": "positive", "name": "revisa como falso positivo com motivo", "as": "gestor", "expect": 200, "params": {"id": "${anomalyId}"}, "body": {"decision": "FALSE_POSITIVE", "reason": "Fechamento mensal conferido."}},
    {"op": "POST /dlp/anomalies/{id}/review", "kind": "negative", "name": "revisão sem motivo", "as": "gestor", "expect": 400, "params": {"id": "${anomalyId}"}, "body": {"decision": "FALSE_POSITIVE"}},
    {"op": "POST /dlp/anomalies/{id}/review", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "params": {"id": "${anomalyId}"}},
    {"op": "POST /dlp/copy-events", "kind": "positive", "name": "registra a cópia negada de um campo sensível", "as": "maker", "expect": 201, "body": {"resourceType": "finance.bank_account", "resourceId": "${uuid}", "field": "accountNumber", "outcome": "DENIED"}},
    {"op": "POST /dlp/copy-events", "kind": "negative", "name": "campo que não existe no registro", "as": "maker", "expect": 400, "body": {"resourceType": "finance.bank_account", "resourceId": "${uuid}", "field": "campoQueNaoExiste", "outcome": "DENIED"}},
    {"op": "POST /dlp/copy-events", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "POST /dlp/share-links", "kind": "positive", "name": "cria o link temporário do contrato", "as": "gestor", "expect": 201, "mfa": true, "headers": {"Idempotency-Key": "${key}"}, "body": {"resourceType": "legal.contract", "resourceId": "${contractId}", "recipientLabel": "Cliente QA-M9", "purpose": "CLIENTE_SOLICITOU", "justification": "Cliente solicitou a copia do documento para analise do seu advogado."}, "capture": {"linkId": "body.data.id", "shareToken": "body.data.token"}},
    {"op": "POST /dlp/share-links", "kind": "negative", "name": "perfil sem a permissão de exportar", "as": "maker", "expect": 403, "headers": {"Idempotency-Key": "${key}"}, "body": {"resourceType": "legal.contract", "resourceId": "${contractId}", "recipientLabel": "Cliente QA-M9", "purpose": "CLIENTE_SOLICITOU", "justification": "Cliente solicitou a copia do documento para analise do seu advogado."}},
    {"op": "POST /dlp/share-links", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /public/share/{token}", "kind": "positive", "name": "abre o link sem login", "as": "anon", "expect": 200, "params": {"token": "${shareToken}"}},
    {"op": "GET /public/share/{token}", "kind": "negative", "name": "token inexistente", "as": "anon", "expect": 404, "params": {"token": "token-que-nao-existe"}},
    {"op": "GET /dlp/share-links", "kind": "positive", "name": "lista os links", "as": "gestor", "expect": 200},
    {"op": "GET /dlp/share-links", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /dlp/share-links", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "GET /dlp/share-links/{id}/impact", "kind": "positive", "name": "impacto de revogar o link", "as": "gestor", "expect": 200, "params": {"id": "${linkId}"}},
    {"op": "GET /dlp/share-links/{id}/impact", "kind": "negative", "name": "link inexistente", "as": "gestor", "expect": 404, "params": {"id": "00000000-0000-4000-8000-000000000000"}},
    {"op": "GET /dlp/share-links/{id}/impact", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "params": {"id": "${linkId}"}},
    {"op": "GET /dlp/share-links/{id}/impact", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403, "params": {"id": "${linkId}"}},
    {"op": "POST /dlp/share-links/{id}/revoke", "kind": "positive", "name": "revoga o link", "as": "gestor", "expect": 200, "confirm": {"impact": "GET /dlp/share-links/{id}/impact"}, "params": {"id": "${linkId}"}},
    {"op": "POST /dlp/share-links/{id}/revoke", "kind": "negative", "name": "revogar de novo", "as": "gestor", "expect": 409, "params": {"id": "${linkId}"}},
    {"op": "POST /dlp/share-links/{id}/revoke", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "params": {"id": "${linkId}"}},
    {"op": "POST /dlp/print-events", "kind": "positive", "name": "pede a impressão do contrato (HIGH: finalidade, justificativa e MFA recente)", "as": "gestor", "expect": 201, "mfa": true, "body": {"resourceType": "legal.contract", "resourceId": "${contractId}", "purpose": "CLIENTE_SOLICITOU", "justification": "Cliente solicitou a via impressa do contrato para assinatura presencial."}, "capture": {"printId": "body.data.exportJobId", "printExp": "body.data.printUrl#exp", "printSig": "body.data.printUrl#sig"}},
    {"op": "POST /dlp/print-events", "kind": "negative", "name": "tipo de documento que não se imprime por aqui", "as": "gestor", "expect": 400, "body": {"resourceType": "finance.entries", "resourceId": "${contractId}", "purpose": "CLIENTE_SOLICITOU", "justification": "Cliente solicitou a via impressa do contrato para assinatura presencial."}},
    {"op": "POST /dlp/print-events", "kind": "negative", "name": "contrato que não existe", "as": "gestor", "expect": 404, "body": {"resourceType": "legal.contract", "resourceId": "00000000-0000-4000-8000-000000000000", "purpose": "CLIENTE_SOLICITOU", "justification": "Cliente solicitou a via impressa do contrato para assinatura presencial."}},
    {"op": "POST /dlp/print-events", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /dlp/print-events/{id}/pdf", "kind": "negative", "name": "assinatura do endereço inválida", "as": "gestor", "expect": 403, "params": {"id": "${printId}"}, "query": {"exp": "${printExp}", "sig": "assinatura-adulterada"}},
    {"op": "GET /dlp/print-events/{id}/pdf", "kind": "positive", "name": "baixa o PDF de impressão", "as": "gestor", "expect": 200, "params": {"id": "${printId}"}, "query": {"exp": "${printExp}", "sig": "${printSig}"}},
    {"op": "GET /dlp/print-events/{id}/pdf", "kind": "negative", "name": "endereço já usado", "as": "gestor", "expect": 410, "params": {"id": "${printId}"}, "query": {"exp": "${printExp}", "sig": "${printSig}"}},
    {"op": "GET /dlp/print-events/{id}/pdf", "kind": "negative", "name": "pedido que não existe", "as": "gestor", "expect": 404, "params": {"id": "${uuid}"}},
    {"op": "GET /dlp/print-events/{id}/pdf", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "params": {"id": "${printId}"}}
  ]
}
