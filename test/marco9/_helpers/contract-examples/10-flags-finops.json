{
  "area": "flags-finops",
  "examples": [
    {"op": "GET /feature-flags", "kind": "positive", "name": "visão geral das chaves", "as": "gestor", "expect": 200},
    {"op": "GET /feature-flags", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /feature-flags", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "POST /feature-flags", "kind": "positive", "name": "cria a flag com responsável, escopo e risco", "as": "gestor", "expect": 201, "body": {"key": "${code}", "value": false, "ownerUserId": "${userId}", "scope": "COMPANY", "scopeRef": "${companyId}", "risk": "LOW"}, "capture": {"flagId": "body.data.id", "flagKey": "body.data.key"}},
    {"op": "POST /feature-flags", "kind": "negative", "name": "valor de tipo errado", "as": "gestor", "expect": 422, "body": {"key": "${code}", "value": "sim", "ownerUserId": "${userId}"}},
    {"op": "POST /feature-flags", "kind": "negative", "name": "chave repetida no escopo", "as": "gestor", "expect": 409, "body": {"key": "${flagKey}", "value": true, "ownerUserId": "${userId}", "scope": "COMPANY", "scopeRef": "${companyId}"}},
    {"op": "POST /feature-flags", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "body": {}},
    {"op": "POST /feature-flags", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403, "body": {}},
    {"op": "PATCH /feature-flags", "kind": "positive", "name": "altera o valor e sobe a versão", "as": "gestor", "expect": 200, "body": {"id": "${flagId}", "version": 1, "value": true, "reason": "QA-M9 liberar"}},
    {"op": "PATCH /feature-flags", "kind": "negative", "name": "versão desatualizada", "as": "gestor", "expect": 409, "body": {"id": "${flagId}", "version": 1, "value": false, "reason": "QA-M9 versão velha"}},
    {"op": "PATCH /feature-flags", "kind": "negative", "name": "chave inexistente", "as": "gestor", "expect": 404, "body": {"id": "${uuid}", "value": true, "reason": "QA-M9"}},
    {"op": "PATCH /feature-flags", "kind": "negative", "name": "valor de tipo errado", "as": "gestor", "expect": 422, "body": {"id": "${flagId}", "value": "sim", "reason": "QA-M9"}},
    {"op": "PATCH /feature-flags", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "body": {}},
    {"op": "PATCH /feature-flags", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403, "body": {}},
    {"op": "GET /finops/health", "kind": "positive", "name": "saúde de custo", "as": "gestor", "expect": 200},
    {"op": "GET /finops/health", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /finops/health", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "GET /finops/budgets", "kind": "positive", "name": "lista os orçamentos", "as": "gestor", "expect": 200},
    {"op": "GET /finops/budgets", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /finops/budgets", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "POST /finops/budgets", "kind": "positive", "name": "cria o orçamento do ambiente", "as": "gestor", "expect": 201, "body": {"environment": "DEV", "domain": "PLATFORM", "amountCents": 300000, "ownerUserId": "${userId}"}, "capture": {"budgetId": "body.data.id"}},
    {"op": "POST /finops/budgets", "kind": "negative", "name": "escopo repetido", "as": "gestor", "expect": 409, "body": {"environment": "DEV", "domain": "PLATFORM", "amountCents": 300000, "ownerUserId": "${userId}"}},
    {"op": "POST /finops/budgets", "kind": "negative", "name": "orçamento zero", "as": "gestor", "expect": 422, "body": {"environment": "HOMOLOG", "domain": "PLATFORM", "amountCents": 0, "ownerUserId": "${userId}"}},
    {"op": "POST /finops/budgets", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "body": {}},
    {"op": "POST /finops/budgets", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403, "body": {}},
    {"op": "PATCH /finops/budgets/{id}", "kind": "positive", "name": "altera o valor", "as": "gestor", "expect": 200, "params": {"id": "${budgetId}"}, "body": {"amountCents": 400000}},
    {"op": "PATCH /finops/budgets/{id}", "kind": "negative", "name": "valor zero", "as": "gestor", "expect": 422, "params": {"id": "${budgetId}"}, "body": {"amountCents": 0}},
    {"op": "PATCH /finops/budgets/{id}", "kind": "negative", "name": "orçamento inexistente", "as": "gestor", "expect": 404, "params": {"id": "${uuid}"}, "body": {"amountCents": 100}},
    {"op": "PATCH /finops/budgets/{id}", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "params": {"id": "${budgetId}"}, "body": {}},
    {"op": "PATCH /finops/budgets/{id}", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403, "params": {"id": "${budgetId}"}, "body": {}},
    {"op": "GET /finops/degradation-policies", "kind": "positive", "name": "lista as políticas de degradação", "as": "gestor", "expect": 200},
    {"op": "GET /finops/degradation-policies", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /finops/degradation-policies", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "PUT /finops/degradation-policies", "kind": "positive", "name": "salva a política do orçamento", "as": "gestor", "expect": 200, "body": {"budgetId": "${budgetId}", "steps": [{"step": "SWITCH_AI_MODEL_CHEAPER"}, {"step": "LIMIT_EXPORT_SIZE"}]}},
    {"op": "PUT /finops/degradation-policies", "kind": "negative", "name": "função crítica na política", "as": "gestor", "expect": 422, "body": {"budgetId": "${budgetId}", "steps": [{"step": "DISABLE_LOGIN"}]}},
    {"op": "PUT /finops/degradation-policies", "kind": "negative", "name": "orçamento inexistente", "as": "gestor", "expect": 404, "body": {"budgetId": "${uuid}", "steps": []}},
    {"op": "PUT /finops/degradation-policies", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401, "body": {}},
    {"op": "PUT /finops/degradation-policies", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403, "body": {}}
  ]
}
