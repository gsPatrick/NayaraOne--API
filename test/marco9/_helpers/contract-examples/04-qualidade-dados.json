{
  "area": "qualidade-dados",
  "examples": [
    {"op": "GET /data-quality", "kind": "positive", "name": "visão geral", "as": "gestor", "expect": 200},
    {"op": "GET /data-quality", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /data-quality", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "GET /data-quality/domains", "kind": "positive", "name": "domínios com dono e curador", "as": "gestor", "expect": 200},
    {"op": "GET /data-quality/domains", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "PUT /data-quality/domains/{code}/assignments", "kind": "positive", "name": "designa dono e curador", "as": "gestor", "expect": 200, "params": {"code": "CORRESPONDENTE"}, "body": {"designations": [{"role": "OWNER", "userId": "${userId}"}, {"role": "STEWARD", "userId": "${makerUserId}"}]}},
    {"op": "PUT /data-quality/domains/{code}/assignments", "kind": "negative", "name": "domínio inexistente", "as": "gestor", "expect": 400, "params": {"code": "INVENTADO"}, "body": {"designations": [{"role": "OWNER", "userId": "${userId}"}]}},
    {"op": "PUT /data-quality/domains/{code}/assignments", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /data-quality/queue", "kind": "positive", "name": "fila de merge", "as": "gestor", "expect": 200, "seed": "dqQueueItem"},
    {"op": "GET /data-quality/queue", "kind": "negative", "name": "perfil sem a permissão da operação", "as": "maker", "expect": 403},
    {"op": "GET /data-quality/queue", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /data-quality/queue/{id}/impact", "kind": "positive", "name": "impacto do merge", "as": "gestor", "expect": 200, "params": {"id": "${queueItemId}"}},
    {"op": "GET /data-quality/queue/{id}/impact", "kind": "negative", "name": "identificador que não é UUID", "as": "gestor", "expect": 404, "params": {"id": "nao-e-uuid"}},
    {"op": "GET /data-quality/queue/{id}/impact", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "POST /data-quality/queue/{id}/decision", "kind": "positive", "name": "mantém separados com nota", "as": "gestor", "expect": 200, "params": {"id": "${queueItemId}"}, "body": {"decision": "KEPT_SEPARATE", "note": "Pessoas diferentes."}},
    {"op": "POST /data-quality/queue/{id}/decision", "kind": "negative", "name": "decisão inválida", "as": "gestor", "expect": 400, "params": {"id": "${queueItemId}"}, "body": {"decision": "TALVEZ"}},
    {"op": "POST /data-quality/queue/{id}/decision", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "POST /data-quality/bulk-changes/impact", "kind": "positive", "name": "simula o lote sem gravar", "as": "gestor", "expect": 200, "seed": "bulkProperties", "body": {"entity_type": "PROPERTY", "filter": {"city": "${bulkCity}"}, "patch": {"city": "Simulado QA"}, "reason": "QA-M9 correção em massa do nome da cidade"}},
    {"op": "POST /data-quality/bulk-changes/impact", "kind": "negative", "name": "filtro fora da lista", "as": "gestor", "expect": 400, "body": {"entity_type": "PROPERTY", "filter": "1=1", "patch": {"city": "X"}, "reason": "QA-M9 filtro inválido"}},
    {"op": "POST /data-quality/bulk-changes/impact", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "POST /data-quality/bulk-changes", "kind": "positive", "name": "aplica o lote com MFA recente", "as": "gestor", "expect": 200, "seed": "mfaEnabled", "mfa": true, "confirm": {"impact": "POST /data-quality/bulk-changes/impact"}, "headers": {"Idempotency-Key": "${key}"}, "body": {"entity_type": "PROPERTY", "filter": {"city": "${bulkCity}"}, "patch": {"city": "Corrigida QA"}, "reason": "QA-M9 correção em massa do nome da cidade"}, "capture": {"bulkId": "body.data.id"}},
    {"op": "POST /data-quality/bulk-changes", "kind": "negative", "name": "perfil sem a permissão do lote", "as": "maker", "expect": 403, "headers": {"Idempotency-Key": "${key}"}, "body": {"entity_type": "PROPERTY", "filter": {"city": "${bulkCity}"}, "patch": {"city": "X"}, "reason": "QA-M9 sem permissão"}},
    {"op": "POST /data-quality/bulk-changes", "kind": "negative", "name": "MFA habilitado, mas sem verificação recente", "as": "gestor", "expect": 403, "headers": {"Idempotency-Key": "${key}"}, "body": {"entity_type": "PROPERTY", "filter": {"city": "${bulkCity}"}, "patch": {"city": "X"}, "reason": "QA-M9 sem verificação recente"}, "clearMfa": true},
    {"op": "POST /data-quality/bulk-changes", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /data-quality/bulk-changes", "kind": "positive", "name": "lista os lotes", "as": "gestor", "expect": 200},
    {"op": "GET /data-quality/bulk-changes", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401},
    {"op": "GET /data-quality/bulk-changes/{id}", "kind": "positive", "name": "lê o lote aplicado", "as": "gestor", "expect": 200, "params": {"id": "${bulkId}"}},
    {"op": "GET /data-quality/bulk-changes/{id}", "kind": "negative", "name": "identificador que não é UUID", "as": "gestor", "expect": 404, "params": {"id": "nao-e-uuid"}},
    {"op": "GET /data-quality/bulk-changes/{id}", "kind": "negative", "name": "sem token", "as": "anon", "expect": 401}
  ]
}
