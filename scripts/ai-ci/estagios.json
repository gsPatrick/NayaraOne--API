{
  "descricao": "Esteira de CI da NAY (M9-D044, Guia seção 15). Ordem e nomes são os do livro e são conferidos por scripts/ai-ci/lib/estagios.js; este arquivo só diz o que cada estágio executa. `testes` = padrões de arquivo (todos entram, nenhum recorte). `banco: true` = só roda em banco descartável (DISPOSABLE_DB=1).",
  "estagios": [
    { "numero": 1, "nome": "lint", "tipo": "automatico", "comandos": [["npm", "run", "lint"]] },
