{
  "name": "nayara-one-api",
  "version": "0.1.0",
  "description": "Nayara One — API do ERP imobiliário/construtora (Fundação Executável / Marco 1).",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "smoke:test": "node scripts/smokeTest.js",
    "seed": "node scripts/seed-dev.js",
    "backup": "node scripts/backupDatabase.js",
    "restore": "node scripts/restoreDatabase.js",
    "verify-restore:construction": "node scripts/verifyRestoreConstructionData.js",
    "verify-restore:finance-legal": "node scripts/verifyRestoreFinanceLegalData.js",
    "restore-drill:legal-full": "node scripts/restoreDrill/legalFullDrill.js",
    "verify-restore:inventory-procurement": "node scripts/verifyRestoreInventoryProcurementData.js",
    "restore-drill:inventory-full": "node scripts/restoreDrill/inventoryFullDrill.js",
    "load-test:inventory": "node scripts/withDisposableDb.js -- node scripts/loadTestInventoryProcurement.js",
    "load-test:analytics": "node scripts/withDisposableDb.js -- node scripts/analytics/loadTest.js",
    "test:failure-drills:inventory": "node scripts/withDisposableDb.js -- node --test --test-concurrency=1 test/inventory.failureDrills.test.js",
    "lint": "node scripts/lintRatchet.js",
    "ai:arch-guard": "node scripts/ai-arch-guard.js",
    "guard:file-size": "node scripts/check-file-size.js",
    "guard:integration-boundaries": "node scripts/checkIntegrationBoundaries.js",
    "guard:formula-tests": "node scripts/analytics/checkFormulaTests.js",
    "guard:analytics-rules": "node scripts/analytics/checkGuardrails.js",
    "guard:sprint-gates": "node scripts/analytics/checkSprintGates.js",
    "dod:bi": "node scripts/analytics/checkDod.js",
    "check:lineage": "node scripts/checkLineageCoverage.js",
    "sync:lineage": "node scripts/withDisposableDb.js -- node scripts/syncLineageRegistry.js",
    "scan:secrets": "node scripts/secretScan.js",
    "lint:openapi": "node scripts/lintOpenapi.js",
    "audit:dependencies": "node scripts/dependencyAudit.js",
    "syntax-check": "find app.js src scripts migrations test -name '*.js' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 -P 4 node --check",
    "backup:scheduled": "node scripts/scheduledBackup.js",
    "test:ai:adversarial": "node scripts/withDisposableDb.js -- env LOG_LEVEL=info CI_TENANT_USERS_PASSWORD=ci-tenant-users-password-not-for-production CLAMAV_HOST=127.0.0.1 CLAMAV_PORT=3310 bash -c \"node scripts/seed-ci-two-tenants.js >/dev/null && NODE_ENV=test node scripts/ai-adversarial-report.js\"",
    "test": "node --test test/*.test.js test/marco8/*.test.js test/integrations/*.test.js \"test/marco9/**/*.test.js\" \"test/analytics/**/*.test.js\""
  },
  "dependencies": {
    "ajv": "^6.12.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
