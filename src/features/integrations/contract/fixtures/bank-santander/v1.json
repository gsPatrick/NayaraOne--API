      }
    },
    "getPaymentStatus": {
      "externalResourceIdFrom": "submitPayment"
    },
    "getStatement": {},
    "verifyWebhook": {
      "rawBody": "{}",
      "headers": {}
    }
  },
  "noResourceId": [
    "getStatement",
    "verifyWebhook"
  ],
  "statuses": {
    "PENDING_EXTERNAL": "PENDING",
    "PROCESSING": "PENDING",
    "CONFIRMED": "PAID",
    "SETTLED": "PAID",
    "REJECTED": "FAILED",
    "CANCELED": "FAILED",
    "EXPIRED": "FAILED",
    "RETURNED": "RETURNED"
  },
  "unknownStatus": "em_analise_do_banco",
  "renewal": false,
  "legacyDouble": "bank-santander"
}
