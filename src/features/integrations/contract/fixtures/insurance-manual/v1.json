{
  "provider": "insurance-manual",
  "apiVersion": "v1",
  "description": "Seguradora sem API: cotar e propor abrem tarefa para uma pessoa e respondem PENDING, sem rede; o duplo de laboratório faz o papel do fluxo manual (tarefa em memória).",
  "requests": {
    "quote": {
      "policyRef": "apolice-contrato-001",
      "insuredAmount": 500000,
      "propertyType": "APARTMENT"
    },
    "propose": {
      "policyRef": "apolice-contrato-001",
      "premiumAmount": 1200,
      "effectiveDate": "2026-11-01",
      "expiryDate": "2027-11-01"
    },
    "getPolicy": {
      "externalResourceIdFrom": "propose"
    },
    "getStatus": {
      "externalResourceIdFrom": "propose"
    },
    "submitClaim": {
      "claimRef": "sinistro-contrato-001",
      "externalPolicyNumber": "APL-0001",
      "description": "Sinistro de laboratório",
      "claimAmount": 800
    }
  },
  "noResourceId": [],
  "statuses": {
    "ACTIVE": "ACTIVE",
    "ISSUED": "ISSUED",
    "QUOTED": "QUOTED",
    "PENDING": "PENDING",
    "UNDER_REVIEW": "UNDER_REVIEW",
    "APPROVED": "APPROVED",
    "DENIED": "DENIED",
    "SETTLED": "SETTLED",
    "EXPIRED": "EXPIRED",
    "CANCELLED": "CANCELED"
  },
  "unknownStatus": "em_subscricao",
  "renewal": false,
  "legacyDouble": "insurance-manual"
}
